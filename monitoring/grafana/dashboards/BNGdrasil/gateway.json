        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"msa-gateway\",service=~\"$service\",method=~\"$method\"}[$__rate_interval]))",
