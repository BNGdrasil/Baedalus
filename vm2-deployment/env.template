# VM2 배포 환경 변수 템플릿
#
# 사용 방법
#   cp env.template .env    # 이미 있는 .env를 덮어쓰지 않도록 주의한다
#   그 뒤에 아래 값을 채운다. 실제 .env는 Git으로 추적하지 않는다.
#
# 이 파일은 /opt/bnbong/.env로 전달되며, docker-compose.yml의 모든 ${...}
# 치환과 컨테이너 환경 변수를 이 파일 하나가 공급한다.
#
# 변수 목록은 두 앱의 Settings가 실제로 읽는 항목에 맞추었다.
#   Bifrost: bifrost/src/core/config.py
#   Bidar:   bidar/src/core/config.py
# 두 앱 모두 `extra="ignore"`이므로 읽지 않는 변수를 넣어도 오류가 나지 않는다.
# 그래서 설정했다고 착각하기 쉬우며, 여기에는 실제로 읽는 값만 둔다.

# ========================================
# 변수 목록 (docker-compose.yml의 모든 ${...}와 대조한 결과다)
# ========================================
# 필수: compose가 `${VAR:?...}`로 참조하므로 값이 없으면 compose 단계에서 중단된다.
#       컨테이너를 만들기 전에 멈추므로 운영 상태가 바뀌지 않는다.
#
#   변수                    쓰는 곳    설명
#   SECRET_KEY              Bifrost    32자 이상이어야 하고 예시 값이면 거부된다.
#   JWT_SECRET_KEY          Bidar      32자 이상이어야 하고 "changethis", "change-me",
#                                      "your-secret-key", "example", "placeholder"가
#                                      들어가면 거부된다.
#   DATABASE_URL            둘 다      VM3 호스트 PostgreSQL 접속 문자열이다.
#   GATEWAY_ALLOWED_HOSTS   Bifrost    Host 헤더 허용 목록이다.
#   AUTH_ALLOWED_HOSTS      Bidar      Host 헤더 허용 목록이다.
#   AUTH_ALLOWED_ORIGINS    Bidar      CORS 허용 origin 목록이다.
#   VM2_PRIVATE_IP          compose    8000번과 8001번 포트의 바인딩 주소다.
#                                      모니터링 compose도 Grafana의 3000번 포트를
#                                      이 주소에 묶는다.
#   GRAFANA_ADMIN_PASSWORD  compose    모니터링 compose만 읽는다. 아래 모니터링
#                                      항목에 설명이 있다.
#
# 선택: compose가 `${VAR:-기본값}`으로 참조하므로 줄이 없어도 기본값이 들어간다.
#       2026-09-19 장애는 이 자리가 `${VAR}`였던 탓에 빈 문자열이 컨테이너로
#       넘어가서 일어났다. 아래 기본값은 docker-compose.yml에 적힌 값과 같다.
#
#   변수                          기본값
#   ENVIRONMENT                   production
#   DEBUG                         false
#   LOG_LEVEL                     INFO
#   JWT_ALGORITHM                 HS256
#   ACCESS_TOKEN_EXPIRE_MINUTES   30
#   REFRESH_TOKEN_EXPIRE_DAYS     7
#   LOGIN_RATE_LIMIT_PER_MINUTE   10
#   RATE_LIMIT_PER_MINUTE         60
#   ENABLE_METRICS                true
#   MAX_REQUEST_BODY_BYTES        10485760
#   FORWARDED_ALLOW_IPS           127.0.0.1
#   CLIENT_ORIGIN                 https://bnbong.com
#   BACKEND_CORS_ORIGINS          https://bnbong.com,https://admin.bnbong.com
#   AUTH_SERVER_IMAGE             ghcr.io/bngdrasil/bidar:main
#   GATEWAY_IMAGE                 ghcr.io/bngdrasil/bifrost:main
#   PROMETHEUS_URL                 (비움)
#   ALERTMANAGER_URL               (비움)
#
# core compose가 읽지 않는 값: DOMAIN_NAME, VM3_PRIVATE_IP, POSTGRES_USER,
#   POSTGRES_PASSWORD, GRAFANA_ADMIN_PASSWORD. 앞의 네 개는 사람이 참고하거나
#   DATABASE_URL을 만들 때 쓴다. GRAFANA_ADMIN_PASSWORD는 docker-compose.yml이
#   아니라 docker-compose.monitoring.yml이 읽으며, 그쪽에서 `${VAR:?...}`로
#   참조하므로 값이 없으면 모니터링 스택의 기동이 중단된다.
#
# 선택 변수라도 운영 .env에는 값을 적어 두는 편이 좋다. 기본값에 기대면 어떤 값으로
# 동작하고 있는지 파일만 보고 알 수 없다.
#
# 새 값 생성 예시
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ========================================
# Environment
# ========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# Domain / CORS
# ========================================
DOMAIN_NAME=bnbong.com

# Bifrost의 CORS 대상은 BACKEND_CORS_ORIGINS와 CLIENT_ORIGIN을 합쳐서 정해진다.
CLIENT_ORIGIN=https://bnbong.com
BACKEND_CORS_ORIGINS=https://bnbong.com,https://admin.bnbong.com

# Bidar의 CORS는 ALLOWED_ORIGINS 하나만 읽는다. BACKEND_CORS_ORIGINS를 넣어도
# Bidar의 CORSMiddleware는 그 값을 쓰지 않는다. 브라우저에서 실제로 호출하는
# 관리자 화면과 공개 사이트의 origin만 적는다.
AUTH_ALLOWED_ORIGINS=https://bnbong.com,https://admin.bnbong.com

# ========================================
# Host 헤더 허용 목록 (TrustedHostMiddleware)
# ========================================
# 두 앱 모두 요청의 Host 헤더를 검사한다. 공개 도메인만 적으면 내부 호출이
# 막히므로 다음을 함께 넣어야 한다.
#   api.bnbong.com   : VM1 Nginx를 거쳐 들어오는 요청
#   admin.bnbong.com : 관리자 도메인의 /admin/api/ 프록시 요청(Gateway)
#   auth-server      : Bifrost가 compose 서비스 이름으로 Bidar를 호출한다
#   gateway          : 같은 네트워크에서 서비스 이름으로 Gateway를 호출하는 경우
#   localhost        : 컨테이너 healthcheck가 http://localhost:<port>/health를 호출한다
#
# 두 앱 모두 쉼표로 구분한 문자열과 JSON 배열을 받는다. 여기에서는 쉼표 표기로 통일한다.
#
# Bidar와 Bifrost 모두 production에서 이 값이 비어 있거나 "*"이면 기동에 실패한다.
# 즉 값을 지우거나 "*"로 두는 실수는 바로 드러난다. 반드시 실제 호스트 목록을 채운
# 상태로 유지해야 한다.
GATEWAY_ALLOWED_HOSTS=api.bnbong.com,admin.bnbong.com,gateway,localhost,127.0.0.1
AUTH_ALLOWED_HOSTS=api.bnbong.com,auth-server,localhost,127.0.0.1

# ========================================
# Security
# 아래 값은 예시이므로 배포 전에 반드시 교체해야 한다.
# ========================================
# Bifrost 전용. production에서 32자 미만이거나 예시 값이면 기동이 실패한다.
SECRET_KEY=change-me-gateway-secret-at-least-32-characters

# Bidar 전용. production에서 32자 미만이거나 예시 문구를 포함하면 기동이 실패한다.
# 이 값을 바꾸면 기존에 발급한 토큰이 모두 무효가 되어 전 사용자가 다시 로그인해야 한다.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# Network binding (SEC-04)
# ========================================
# VM2의 private IP다. VM1 Nginx가 이 주소의 8000/8001 포트로 접근하기 때문에
# 포트를 loopback에만 묶을 수 없다. public IP에는 게시하지 않는다.
# compose가 `${VM2_PRIVATE_IP:?...}`로 참조하므로 비워 두면 기동이 중단된다.
VM2_PRIVATE_IP=10.0.1.60

# VM3의 private IP다. 호스트 PostgreSQL 14와 Redis가 여기에서 동작한다.
VM3_PRIVATE_IP=10.0.2.134

# uvicorn이 X-Forwarded-* 헤더를 신뢰할 발신지다. VM1 Nginx만 신뢰한다.
# 값을 "*"로 두면 VM2에 직접 연결한 쪽이 클라이언트 IP를 위조할 수 있고,
# Bidar의 로그인 제한이 실제 호출자를 구분하지 못한다.
FORWARDED_ALLOW_IPS=10.0.1.133

# ========================================
# Database (VM3 호스트 PostgreSQL)
# ========================================
POSTGRES_USER=bnbong
POSTGRES_PASSWORD=change-me-postgres-password
# Bidar와 Bifrost가 함께 사용하는 접속 문자열이다. 두 앱 모두 production에서
# 이 값이 비어 있으면 기동이 실패한다(DEP-01).
DATABASE_URL=postgresql://bnbong:change-me-postgres-password@10.0.2.134:5432/bngdrasil

# ========================================
# 요청 제한
# ========================================
# Bifrost 전용. 게이트웨이 전체에 적용되는 in-process 제한이다.
RATE_LIMIT_PER_MINUTE=60

# Bidar 전용. POST /auth/token에만 적용되며 worker마다 따로 센다.
# Bidar는 RATE_LIMIT_PER_MINUTE를 읽지 않으므로 이 값과 혼동하지 않는다.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ========================================
# Bifrost 동작 설정
# ========================================
ENABLE_METRICS=true

# 버퍼링 프록시라서 요청 본문 전체를 메모리에 담는다. 10MiB 기본값이다.
MAX_REQUEST_BODY_BYTES=10485760

# AUTH_SERVER_USERS_PATH는 기본값 /users가 현재 Bidar 배포와 맞으므로 두지 않는다.
# Bidar가 사용자 관리 라우터를 옮길 때만 추가한다.

# Bifrost의 관측 요약 엔드포인트가 Prometheus/Alertmanager를 호출할 주소다. 둘 다
# 선택 값이며 기본값을 두지 않는다. 비워 두면 관련 관리자 엔드포인트가 501을
# 돌려주고 게이트웨이 자체는 정상 기동한다. 값은 모니터링 compose와 같은
# api-network 내부 이름을 쓰며, 게이트웨이 밖으로 게시되지 않는다.
PROMETHEUS_URL=http://prometheus:9090

# Alertmanager도 같은 이유로 기본값을 두지 않는다. 비워 두면 관련 엔드포인트만 501을
# 돌려준다.
ALERTMANAGER_URL=

# ========================================
# 더 이상 사용하지 않는 변수
# ========================================
# SERVICES_CONFIG_PATH : 서비스 등록부가 PostgreSQL의 services 테이블로 옮겨져서
#                        Bifrost가 JSON 등록부를 읽지 않는다.
# REDIS_URL            : Bidar와 Bifrost의 Settings에서 사라졌다. VM2 Redis의
#                        현재 소비자는 확인되지 않았다.
# ALLOWED_ORIGINS      : Bifrost는 이 이름을 읽지 않는다. Bidar용 값은
#                        AUTH_ALLOWED_ORIGINS로 분리했다.

# ========================================
# 배포 image 참조
# ========================================
# 이 두 변수가 현재 어떤 image로 컨테이너가 떠 있는지를 결정한다. compose의
# 기본값은 ghcr.io/bngdrasil/bidar:main과 ghcr.io/bngdrasil/bifrost:main이므로,
# 두 줄을 지우면 특정 release가 아니라 main 태그가 올라간다. 따라서 운영
# /opt/bnbong/.env에서는 두 줄을 항상 유지한다.
#
# 평소에는 직접 편집하지 않는다. Bidar와 Bifrost 저장소의 release 워크플로가
# VM2의 /opt/bnbong/deploy-image.sh를 호출하고, 그 스크립트가 해당 줄만 새
# image 참조로 바꾼 뒤 컨테이너를 교체한다. 되돌릴 때에만 손으로 바꾸며,
# 그 절차는 vm2-deployment/README.md의 롤백 항목에 있다.
#
# GHCR image를 쓸 수 없어서 deploy.sh로 현장 build를 할 때에는 두 값이
# bnbong-gateway:<짧은 SHA> 형태로 바뀐다. deploy.sh가 저장소 HEAD의 짧은 SHA로
# 이 값을 자동 지정하기 때문이다.
AUTH_SERVER_IMAGE=ghcr.io/bngdrasil/bidar:main
GATEWAY_IMAGE=ghcr.io/bngdrasil/bifrost:main

# ========================================
# 모니터링 (docker-compose.monitoring.yml)
# ========================================
# Grafana 관리자 비밀번호다. 이 값이 비어 있으면 Grafana가 기본 비밀번호로 뜨고,
# 그 화면은 VM1 Nginx를 거쳐 monitoring.bnbong.com으로 공개된다. 모니터링
# compose가 `${GRAFANA_ADMIN_PASSWORD:?...}`로 참조하므로, 값을 비우면 컨테이너를
# 만들기 전에 compose 단계에서 중단된다.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Alertmanager의 Discord webhook URL은 이 파일에 두지 않는다. 환경 변수가 아니라
# /opt/bnbong/secrets/discord-webhook-url 파일에서 읽으며, 그 파일은 저장소를
# VM2로 전송하는 rsync의 대상 밖에 있어야 배포할 때 덮어써지지 않는다.
#
# 그 파일의 소유자는 root가 아니라 65534:65534여야 하고 권한은 600이다.
# Alertmanager 컨테이너가 uid 65534로 실행되기 때문이다. 소유자를 root로 두면
# 컨테이너는 정상으로 뜨지만 경보가 실제로 발생한 시점에 permission denied로
# 통지를 버리므로, 통지가 필요한 순간까지 문제를 알 수 없다.
# 배치 절차와 확인 방법은 monitoring/README.md의 "통지 경로" 항목에 있다.
