# BNGdrasil 백업 환경 파일 템플릿.
# 실제 파일은 /etc/bngdrasil-backup/env 이며 권한은 600, 소유자는 root 여야 한다.
# 이 템플릿에는 변수 이름과 설명만 두고 실제 비밀 값을 적지 않는다.

# --- 저장 경로 ---------------------------------------------------------------
# 백업 파일이 쌓이는 최상위 디렉터리.
#BACKUP_ROOT=/var/backups/bngdrasil
# 실행 상태 JSON 을 두는 디렉터리. 기본값은 $BACKUP_ROOT/state 이다.
#STATE_DIR=/var/backups/bngdrasil/state
# 잠금 파일 디렉터리. 기본값은 $BACKUP_ROOT/locks 이다. 구성 요소별 잠금이 여기에 쌓인다.
#LOCK_DIR=/var/backups/bngdrasil/locks
# run.sh 와 retention.sh 와 ship.sh 가 공유하는 잠금 파일. 세 스크립트가 같은 백업
# 디렉터리를 동시에 건드리지 않도록 이름을 하나로 통일한다.
#BK_LOCK_FILE=/var/backups/bngdrasil/state/backup.lock
# 공용 잠금을 기다릴 최대 시간(초). 0 으로 두면 기다리지 않고 바로 실패한다.
#BK_LOCK_WAIT_SEC=300

# --- Prometheus textfile collector -------------------------------------------
# node_exporter 의 --collector.textfile.directory 와 같은 경로를 지정한다.
#METRICS_DIR=/var/lib/node_exporter/textfile_collector
# metric 출력을 끄려면 0 으로 둔다.
#METRICS_ENABLED=1

# --- PostgreSQL --------------------------------------------------------------
# 백업할 데이터베이스 이름을 공백으로 구분하여 나열한다.
#PG_DATABASES="bngdrasil phishing_data postgres"
# pg_dump 실행 방법. VM3 는 로컬 peer 인증을 쓰므로 비밀번호가 필요하지 않다.
#PG_DUMP_CMD="sudo -n -u postgres pg_dump"
#PG_DUMPALL_CMD="sudo -n -u postgres pg_dumpall"
#PG_RESTORE_CMD="pg_restore"
# pg_dump 의 --lock-wait-timeout 값(밀리초).
#PG_LOCK_WAIT_MS=15000
# 성공 이력이 없을 때 요구할 최소 여유 공간(바이트). 기본값은 1GiB 이다.
#PG_MIN_FREE_BYTES=1073741824

# --- Redis -------------------------------------------------------------------
# "이름:모드:대상[:포트]" 형식을 공백으로 구분한다. 모드는 container 또는 host 이다.
# VM2 의 vm2-redis 를 VM3 에서 직접 받을 수는 없으므로 VM2 에 따로 설치하여 실행한다.
#REDIS_TARGETS="vm3:container:vm3-redis"
# 비밀번호가 설정된 Redis 라면 값을 적은 600 권한 파일의 경로를 지정한다.
#REDIS_PASSWORD_FILE=/etc/bngdrasil-backup/redis-password
#REDIS_MIN_FREE_BYTES=536870912
#REDIS_BGSAVE_TIMEOUT=120

# --- SQLite ------------------------------------------------------------------
# "이름:절대경로" 형식을 공백으로 구분한다. VM2 에서만 사용한다.
#SQLITE_TARGETS="overlock:/var/lib/overlock/overlock.sqlite grafana:/var/lib/docker/volumes/<볼륨>/_data/grafana.db"
#SQLITE_MIN_FREE_BYTES=268435456

# --- 실행 대상 토글 -------------------------------------------------------------
# 호스트 PostgreSQL 이 없는 서버(예: VM2)에서는 false 로 두어 그 단계를 건너뛴다.
#RUN_POSTGRESQL=true
# 보존 정책 단계를 끄려면 0 으로 둔다.
#RUN_RETENTION=1
# 백업 직후에 독립 보관 전송을 수행할지 정한다. 오프사이트 RPO 6시간은 이 값이 true 일
# 때에만 성립한다. 전송 설정이 없는 호스트에서는 반드시 false 로 두어야 한다. false 로
# 두면 retention.sh 도 SHIPPED 표시를 요구하지 않는다.
#SHIP_ENABLED=true

# --- 보존 정책 ---------------------------------------------------------------
#RETENTION_DAILY=7
#RETENTION_WEEKLY=4
#RETENTION_MONTHLY=3
# 실패 디렉터리를 정리하기까지 기다리는 일수.
#RETENTION_FAILED_DAYS=7
# 아직 전송하지 못한 성공본을 몇 개까지 허용할지 정한다. 이 값을 넘으면 retention.sh 가
# 성공본을 지우는 대신 exit 1 과 알림으로 상황을 드러낸다. 기본값 8 은 6시간 주기
# 기준으로 48시간분에 해당한다.
#RETENTION_MAX_UNSHIPPED=8
# 세대 정리 대상을 전송 완료본으로 제한할지 정한다. 기본값은 SHIP_ENABLED 값을 따른다.
#RETENTION_REQUIRE_SHIPPED=true

# --- 독립 보관 전송 ------------------------------------------------------------
# age 또는 gpg 를 선택한다. none 은 허용하지 않는다.
#SHIP_ENCRYPTION=age
# age 수신자 공개 키 목록 파일(600). 복호화용 개인 키는 VM3 에 두지 않는다.
#AGE_RECIPIENTS_FILE=/etc/bngdrasil-backup/age-recipients.txt
# gpg 대칭 암호 passphrase 파일(600).
#GPG_PASSPHRASE_FILE=/etc/bngdrasil-backup/gpg-passphrase
# 전송 대상 SSH 호스트. 아래 SSH 설정 파일에 정의한 Host 별칭을 지정한다.
#SHIP_SSH_HOST=bngdrasil-vm4
#SHIP_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new"
# SSH 설정과 개인 키는 root 홈이 아니라 아래 경로에 둔다. 유닛이 ProtectHome=yes 로
# 실행되므로 ~/.ssh 에는 닿지 않는다. 파일 권한은 600 이어야 한다.
#SHIP_SSH_DIR=/etc/bngdrasil-backup/ssh
#SHIP_SSH_CONFIG=/etc/bngdrasil-backup/ssh/config
#SHIP_SSH_IDENTITY=/etc/bngdrasil-backup/ssh/id_ed25519
#SHIP_SSH_KNOWN_HOSTS=/etc/bngdrasil-backup/ssh/known_hosts
#SHIP_REMOTE_DIR=/var/backups/bngdrasil-offsite
# rsync 대상을 직접 지정하려면 사용한다. 지정하면 원격 디렉터리 준비 단계를 건너뛴다.
#SHIP_TARGET=
# 전송한 뒤 원격에서 sha256 값을 다시 확인할지 정한다. 0 으로 두면 검증 없이 SHIPPED
# 표시를 남기므로, 오프사이트 사본을 확인하지 않은 백업이 보존 정책의 삭제 대상이 된다.
#SHIP_VERIFY=1
# SHIP_TARGET 을 직접 지정한 경우에는 검증에 사용할 호스트와 경로를 따로 적는다.
#SHIP_VERIFY_SSH_HOST=bngdrasil-vm4
#SHIP_VERIFY_REMOTE_DIR=/var/backups/bngdrasil-offsite

# --- 알림 ---------------------------------------------------------------------
# Discord 또는 Slack incoming webhook URL. 비워 두면 syslog 에만 기록한다.
#NOTIFY_WEBHOOK_URL=
# discord 또는 slack.
#NOTIFY_WEBHOOK_KIND=discord
#NOTIFY_HOSTNAME=bngdrasil-vm3
#NOTIFY_TIMEOUT=10
# 성공했을 때에도 알릴지 여부. 기본값 0 은 실패에만 알린다는 뜻이다.
#NOTIFY_ON_SUCCESS=0

# --- 복원 훈련 -----------------------------------------------------------------
# 격리 복원에 사용할 PostgreSQL major 버전. I04 사전 시험에서는 17 로 바꾼다.
#VERIFY_PG_VERSION=14
#VERIFY_PORT=55439
