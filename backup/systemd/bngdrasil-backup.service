[Unit]
Description=BNGdrasil 백업 실행 (PostgreSQL, Redis, SQLite, 보존 정책, 독립 보관 전송)
Documentation=file:///opt/bngdrasil-backup/README.md
After=network-online.target postgresql.service docker.service
Wants=network-online.target
OnFailure=bngdrasil-backup-notify@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/bngdrasil-backup/run.sh
EnvironmentFile=-/etc/bngdrasil-backup/env
TimeoutStartSec=10800
Nice=10
IOSchedulingClass=idle
ProtectHome=yes
PrivateTmp=no
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
