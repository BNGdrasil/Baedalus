[Unit]
Description=BNGdrasil 격리 복원 훈련
Documentation=file:///opt/bngdrasil-backup/README.md
After=network-online.target docker.service
Wants=network-online.target
OnFailure=bngdrasil-backup-notify@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/bngdrasil-backup/verify-restore.sh
EnvironmentFile=-/etc/bngdrasil-backup/env
TimeoutStartSec=3600
Nice=15
IOSchedulingClass=idle
ProtectHome=yes
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
